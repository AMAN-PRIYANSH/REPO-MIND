{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent_result_row.schema.json",
  "title": "AgentResultRow",
  "description": "One per-case row of a committed CP6 result file (docs/results/cp6/agent__<arm>__<model>.json). Closed set of keys: no prompt, no raw model reply, no code or advisory text can be committed through it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "created", "cluster_key", "n_candidates", "gold_ids", "gold_derived_ids", "gold_in_candidates", "a0_top3",
               "stop_reason", "budget_reason", "error", "answer", "abstain", "evidence", "steps", "llm_calls", "input_tokens",
               "output_tokens", "max_call_prompt_tokens", "agent_seconds", "wall_seconds", "counters", "tool_counts",
               "graph_tools_available", "commit_diffs_available", "answer_ids_seen", "trace_id", "reused_trace"],
  "properties": {
    "id": {"type": "string"},
    "created": {"type": ["string", "null"]},
    "cluster_key": {"type": "string"},
    "n_candidates": {"type": "integer", "minimum": 0},
    "gold_ids": {"type": "array", "items": {"type": "string", "maxLength": 16}},
    "gold_derived_ids": {"type": "array", "items": {"type": "string", "maxLength": 16}},
    "gold_in_candidates": {"type": "boolean"},
    "a0_top3": {"type": "array", "items": {"type": "string", "maxLength": 16}, "maxItems": 3},
    "stop_reason": {"enum": ["SUBMITTED", "ABSTAINED", "INVALID_ANSWER", "INVALID_ACTION", "LOOP_DETECTED", "BUDGET_EXCEEDED", "ERROR", "NOT_RUN"]},
    "budget_reason": {"enum": [null, "STEPS", "TOKENS", "CONTEXT", "TIME"]},
    "error": {"type": ["string", "null"], "maxLength": 40},
    "answer": {"type": "array", "items": {"type": "string", "maxLength": 16}, "maxItems": 3},
    "abstain": {"type": "boolean"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["candidates", "commits"],
                 "properties": {"candidates": {"type": "integer"}, "commits": {"type": "integer"}}},
    "steps": {"type": "integer", "minimum": 0},
    "llm_calls": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "max_call_prompt_tokens": {"type": "integer", "minimum": 0},
    "agent_seconds": {"type": "number", "minimum": 0},
    "wall_seconds": {"type": "number", "minimum": 0},
    "counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "tool_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "graph_tools_available": {"type": "boolean"},
    "commit_diffs_available": {"type": "boolean"},
    "answer_ids_seen": {"type": ["boolean", "null"]},
    "trace_id": {"type": ["string", "null"]},
    "reused_trace": {"type": "boolean"}
  }
}
