{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "helper_response.schema.json",
  "title": "HelperResponse",
  "description": "The one JSON object vt-helper writes to stdout (contract 1.x).",
  "type": "object",
  "required": ["contract_version", "ok", "mode"],
  "properties": {
    "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "ok": {"type": "boolean"},
    "mode": {"type": "string"}
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["toolchain", "results", "stats"],
      "properties": {
        "contract_version": true, "mode": {"enum": ["funcs", "reach", "edges", "naive", "lift", "callers", "callees"]},
        "ok": {"const": true},
        "toolchain": {"$ref": "#/$defs/toolchain"},
        "results": {"type": "array"},
        "stats": {"$ref": "#/$defs/stats"},
        "load": {"$ref": "#/$defs/load"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"enum": ["reach", "naive"]}}}, "then": {"properties": {"results": {"items": {"$ref": "#/$defs/target_result"}}}}},
        {"if": {"properties": {"mode": {"const": "edges"}}}, "then": {"properties": {"results": {"items": {"$ref": "#/$defs/edge_result"}}}}},
        {"if": {"properties": {"mode": {"const": "funcs"}}}, "then": {"properties": {"results": {"items": {"$ref": "#/$defs/file_funcs"}}}}},
        {"if": {"properties": {"mode": {"const": "lift"}}}, "then": {"properties": {"results": {"items": {"$ref": "#/$defs/lift_result"}}}}},
        {"if": {"properties": {"mode": {"enum": ["callers", "callees"]}}}, "then": {"properties": {"results": {"items": {"$ref": "#/$defs/neighbor_result"}}}}}
      ]
    },
    {
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "contract_version": true, "mode": true,
        "ok": {"const": false},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["BAD_REQUEST", "CONTRACT_MISMATCH", "LOAD_FAILED", "TYPE_ERRORS", "TARGET_NOT_FOUND", "INTERNAL"]},
            "message": {"type": "string"}
          }
        }
      }
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "symbol"],
      "properties": {"package": {"type": "string"}, "symbol": {"type": "string"}}
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {"file": {"type": "string"}, "line": {"type": "integer", "minimum": 0}}
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["go_version", "goos", "goarch", "x_tools_version"],
      "properties": {
        "go_version": {"type": "string"}, "goos": {"type": "string"}, "goarch": {"type": "string"},
        "x_tools_version": {"type": "string"}
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages_loaded", "callgraph_nodes", "callgraph_edges", "duration_ms", "peak_rss_kb"],
      "properties": {
        "packages_loaded": {"type": "integer", "minimum": 0},
        "callgraph_nodes": {"type": "integer", "minimum": 0},
        "callgraph_edges": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "peak_rss_kb": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "call_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "target", "edges"],
      "properties": {
        "entry": {"$ref": "#/$defs/target"},
        "target": {"$ref": "#/$defs/target"},
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["caller", "callee", "call_site", "kind"],
            "properties": {
              "caller": {"type": "string", "minLength": 1},
              "callee": {"type": "string", "minLength": 1},
              "call_site": {"$ref": "#/$defs/site"},
              "kind": {"enum": ["STATIC", "DYNAMIC"]}
            }
          }
        }
      }
    },
    "target_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "result", "paths", "shortest_length", "paths_omitted", "matched_functions", "error", "package_not_in_program"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "result": {"enum": ["PATH_FOUND", "NO_PATH", "ERROR"]},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/call_path"}},
        "shortest_length": {"type": ["integer", "null"], "minimum": 0},
        "paths_omitted": {"enum": [null, "MAX_PATH_LENGTH"]},
        "matched_functions": {"type": "array", "items": {"type": "string"}},
        "package_not_in_program": {
          "type": "boolean",
          "description": "true only when result is NO_PATH because the target's package is not part of the loaded program at all (interfaces contract, section 2)."
        },
        "error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "message"],
              "properties": {
                "code": {"enum": ["TARGET_NOT_FOUND", "UNSUPPORTED_SYMBOL_FORM"]},
                "message": {"type": "string"}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "ERROR"}}},
          "then": {"properties": {"error": {"type": "object"}, "paths": {"maxItems": 0}}},
          "else": {"properties": {"error": {"type": "null"}}}
        },
        {
          "if": {"properties": {"result": {"const": "PATH_FOUND"}}},
          "then": {"properties": {"shortest_length": {"type": "integer"}}},
          "else": {"properties": {"paths": {"maxItems": 0}, "shortest_length": {"type": "null"}}}
        },
        {
          "if": {"properties": {"package_not_in_program": {"const": true}}},
          "then": {"properties": {"result": {"const": "NO_PATH"}}}
        }
      ]
    },
    "edge_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller", "callee", "call_site", "exists", "caller_found", "callee_found", "call_sites", "kinds"],
      "properties": {
        "caller": {"type": "string"},
        "callee": {"type": "string"},
        "call_site": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/site"}]},
        "exists": {"type": "boolean"},
        "caller_found": {"type": "boolean"},
        "callee_found": {"type": "boolean"},
        "call_sites": {"type": "array", "items": {"$ref": "#/$defs/site"}},
        "kinds": {"type": "array", "items": {"enum": ["STATIC", "DYNAMIC"]}}
      }
    },
    "file_funcs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "package", "functions"],
      "properties": {
        "file": {"type": "string"},
        "package": {"type": "string"},
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["symbol", "start", "end"],
            "properties": {
              "symbol": {"type": "string", "minLength": 1},
              "start": {"type": "integer", "minimum": 1},
              "end": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "packages_matched", "packages_skipped", "first_errors"],
      "properties": {
        "mode": {"enum": ["LIBRARY", "APP"]},
        "packages_matched": {"type": "integer", "minimum": 0},
        "packages_skipped": {"type": "integer", "minimum": 0},
        "first_errors": {"type": "array", "items": {"type": "string"}}
      }
    },
    "per_target_error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message"],
          "properties": {
            "code": {"enum": ["TARGET_NOT_FOUND", "UNSUPPORTED_SYMBOL_FORM", "PACKAGE_NOT_LOADED"]},
            "message": {"type": "string"}
          }
        }
      ]
    },
    "lift_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "symbol", "depth", "dynamic", "path"],
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "depth": {"type": "integer", "minimum": 0},
        "dynamic": {"type": "boolean"},
        "path": {"$ref": "#/$defs/call_path"}
      }
    },
    "lift_rule_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "depth_limit_reached"],
      "properties": {
        "entries": {"type": "array", "items": {"$ref": "#/$defs/lift_entry"}},
        "depth_limit_reached": {"type": "boolean"}
      }
    },
    "lift_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "rules", "matched_functions", "error", "package_not_in_program"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "status": {"enum": ["LIFTED", "ALREADY_EXPORTED", "ROOT_ONLY", "PACKAGE_NOT_IN_PROGRAM", "ERROR"]},
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "NEAREST": {"$ref": "#/$defs/lift_rule_result"},
            "ALL": {"$ref": "#/$defs/lift_rule_result"}
          }
        },
        "matched_functions": {"type": "array", "items": {"type": "string"}},
        "error": {"$ref": "#/$defs/per_target_error"},
        "package_not_in_program": {"type": "boolean"}
      }
    },
    "hop_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hop", "caller", "callee", "call_site", "kind", "other"],
      "properties": {
        "hop": {"type": "integer", "minimum": 1},
        "caller": {"type": "string", "minLength": 1},
        "callee": {"type": "string", "minLength": 1},
        "call_site": {"$ref": "#/$defs/site"},
        "kind": {"enum": ["STATIC", "DYNAMIC"]},
        "other": {"$ref": "#/$defs/target"}
      }
    },
    "neighbor_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "result", "edges", "truncated", "matched_functions", "error", "package_not_in_program"],
      "properties": {
        "target": {"$ref": "#/$defs/target"},
        "result": {"enum": ["FOUND", "NONE", "PACKAGE_NOT_IN_PROGRAM", "ERROR"]},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/hop_edge"}},
        "truncated": {"type": "boolean"},
        "matched_functions": {"type": "array", "items": {"type": "string"}},
        "error": {"$ref": "#/$defs/per_target_error"},
        "package_not_in_program": {"type": "boolean"}
      }
    }
  }
}
